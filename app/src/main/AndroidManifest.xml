<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Do Not Disturb at prayer time. Android grants it only from its own
         settings screen ("Do Not Disturb access"), never from a dialog. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Exact timing for on-time prayer notifications, granted without any
         prompt: USE_EXACT_ALARM on Android 13+, SCHEDULE_EXACT_ALARM (granted
         by default) on 12/12L. The user never sees an "Alarms & reminders"
         screen; if exact timing is revoked, notifications fall back to
         inexact scheduling. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrayerNotifier">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PrayerNotifier">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".data.notifications.PrayerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.example.prayernotifier.ACTION_PRAYER_ALARM" />
                <action android:name="com.example.prayernotifier.ACTION_REPLENISH" />
                <action android:name="com.example.prayernotifier.ACTION_SILENCE_START" />
                <action android:name="com.example.prayernotifier.ACTION_SILENCE_END" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
